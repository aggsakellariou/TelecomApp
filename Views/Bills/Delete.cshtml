@model TelecomApp.Models.Bill

@{
    ViewData["Title"] = "Delete";
}

<h2>Bill Payment</h2>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Costs)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Costs)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Phone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Phone.PhoneNumber)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" name="userType" value="@ViewData["UserType"]" />
        <input type="hidden" name="userId" value="@ViewData["UserId"]" />

        <input type="hidden" asp-for="BillId" />
        <a href="javascript:history.back()" class="btn btn-secondary">Back</a>
        <input type="submit" value="Pay" class="btn btn-dark" />
    </form>
</div>
