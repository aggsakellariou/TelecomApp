@model TelecomApp.Models.UserClient

@{
    ViewData["Title"] = "Create";
}

<h2>Create Client</h2>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="User.FirstName" class="control-label"></label>
                <input asp-for="User.FirstName" class="form-control" />
                <span asp-validation-for="User.FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="User.LastName" class="control-label"></label>
                <input asp-for="User.LastName" class="form-control" />
                <span asp-validation-for="User.LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="User.Username" class="control-label"></label>
                <input asp-for="User.Username" class="form-control" />
                <span asp-validation-for="User.Username" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input asp-for="User.Property" type="hidden" value="Client" />
            </div>
            <div class="form-group">
                <label asp-for="Client.Afm" class="control-label"></label>
                <input asp-for="Client.Afm" class="form-control" />
                <span asp-validation-for="Client.Afm" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Phone.PhoneNumber" class="control-label"></label>
                <input asp-for="Phone.PhoneNumber" class="form-control" />
                <span asp-validation-for="Phone.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Phone.ProgramId" class="control-label"></label>
                <select asp-for="Phone.ProgramId" class="form-control" asp-items="ViewBag.ProgramId"></select>
                <span asp-validation-for="Phone.ProgramId" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="hidden" name="userType" value="@ViewData["UserType"]" />
                <input type="hidden" name="userId" value="@ViewData["userId"]" />
                <input type="hidden" name="phoneId" value="@ViewData["phoneId"]" />

                <a href="javascript:history.back()" class="btn btn-secondary">Back</a>
                <input type="submit" value="Create" class="btn btn-dark" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}