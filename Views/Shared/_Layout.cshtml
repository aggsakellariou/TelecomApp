@{
    var userType = Context.Request.Query["userType"].ToString();
    var userId = Context.Request.Query["userId"].ToString();
    bool isLoggedIn = userType == "Seller" || userType == "Admin" || userType == "Client";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TelecomApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TelecomApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand">Telecom</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (userType == "Client")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light-emphasis" asp-area="" asp-controller="Bills" asp-action="Index" asp-route-userType="@userType" asp-route-userId="@userId">Bills</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light-emphasis" asp-area="" asp-controller="Calls" asp-action="Index" asp-route-userType="@userType" asp-route-userId="@userId">Calls</a>
                            </li>
                        }
                        @if (userType == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light-emphasis" asp-area="" asp-controller="PhonePrograms" asp-action="Index" asp-route-userType="@userType">Programs</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light-emphasis" asp-area="" asp-controller="Sellers" asp-action="Index" asp-route-userType="@userType">Sellers</a>
                            </li>

                        }
                        @if (userType == "Seller")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light-emphasis" asp-area="" asp-controller="Clients" asp-action="Index" asp-route-userType="@userType" asp-route-userId="@userId">Clients</a>
                            </li>
                        }
                    </ul>
                    @if (isLoggedIn)
                    {
                        <a class="btn btn-outline-danger" asp-area="" asp-controller="Login" asp-action="Logout" asp-route-userType="@userType">Logout</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted bg-dark text-light py-2">
        <div class="container">
            &copy; 2024 - TelecomApp
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>